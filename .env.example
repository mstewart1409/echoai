# Transcript viewer runtime config
TRANSCRIPT_VIEWER_HOST=0.0.0.0
TRANSCRIPT_VIEWER_PORT=5000

# Optional path overrides inside the container
TRANSCRIPT_VIEWER_DOWNLOADS_DIR=/app/downloads
TRANSCRIPT_VIEWER_TRANSCRIPTS_DIR=/app/transcripts
TRANSCRIPT_VIEWER_STATIC_DIR=/app/echoai/viewer

# Use a smaller model on Raspberry Pi if memory is constrained.
TRANSCRIPT_VIEWER_SPACY_MODEL=de_core_news_sm

# Chromecast receiver application id used by the sender UI.
TRANSCRIPT_VIEWER_CAST_RECEIVER_APP_ID=

# Required to protect all endpoints (sender authenticates; receiver uses signed token).
# Set AUTH_DISABLED=1 for local development only - never in production.
TRANSCRIPT_VIEWER_AUTH_DISABLED=0
TRANSCRIPT_VIEWER_AUTH_USERNAME=
TRANSCRIPT_VIEWER_AUTH_PASSWORD=
TRANSCRIPT_VIEWER_AUTH_SESSION_SECRET=
TRANSCRIPT_VIEWER_AUTH_SESSION_TTL_SECONDS=86400

# Send the session cookie only over HTTPS. Must be 1 in production.
TRANSCRIPT_VIEWER_COOKIE_SECURE=1

# Token signing and enforcement settings for receiver media requests.
TRANSCRIPT_VIEWER_CAST_SIGNING_KEY=
# Must exceed the longest episode: the Chromecast media URL embeds this token
# and is never rewritten, so a seek after expiry fails. See docs/CHROMECAST.md.
TRANSCRIPT_VIEWER_CAST_TOKEN_TTL_SECONDS=10800
TRANSCRIPT_VIEWER_CAST_TOKEN_REQUIRED_FOR_MEDIA=1

# Root log level (DEBUG, INFO, WARNING, ERROR).
TRANSCRIPT_VIEWER_LOG_LEVEL=INFO

# Log file backing the /logs viewer page. Must be writable: in Docker the root
# filesystem is read-only, so this has to stay under /tmp. Logs are therefore
# lost on restart - they are for debugging, not an audit trail.
# Set empty to disable file logging (console only).
TRANSCRIPT_VIEWER_LOG_FILE=/tmp/echoai.log

# Rotation caps total log disk use at roughly MAX_BYTES * (BACKUP_COUNT + 1).
TRANSCRIPT_VIEWER_LOG_MAX_BYTES=2000000
TRANSCRIPT_VIEWER_LOG_BACKUP_COUNT=3
